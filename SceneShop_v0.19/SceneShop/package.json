    "native:signature:verify": "node tools/native-signature-verify.js",
    "rc:evidence:export": "node tools/v019-evidence-export.js --out=artifacts/runner-export",
    "rc:finalize:dry": "node tools/v019-finalize.js --source=artifacts/external-evidence",
    "rc:finalize": "node tools/v019-finalize.js --source=artifacts/external-evidence --apply",
    "test:i18n": "node test/i18n.e2e.mjs",
    "test:acr": "node test/acr.e2e.mjs",
