    "beta:verify:distribution": "node tools/v018-production-beta-manifest.js --require-distribution --out=artifacts/production-beta/v0.18-production-beta-manifest.json",
    "beta:promote:dry": "node tools/v018-promote.js",
    "beta:promote": "node tools/v018-promote.js --apply",
    "test:rc19": "node --test test/rcprep9.test.js test/store-sync.test.js test/audio-id.test.js test/v019-release-candidate.test.js test/v019-analysis-regressions.test.js test/acr.test.js test/i18n.test.js",
    "rc:contract": "node tools/v019-release-contract.js",
    "rc:schema": "node tools/v019-schema-compatibility.js",
    "rc:schema:live": "node tools/v019-schema-compatibility.js --require-live --ephemeral --out=artifacts/rc-gate/schema-compatibility.json",
    "rc:manifest": "node tools/v019-rc-manifest.js --out=artifacts/rc-gate/v0.19-rc-manifest.json",
    "rc:verify": "node tools/v019-rc-manifest.js --require-eligible --out=artifacts/rc-gate/v0.19-rc-manifest.json",
