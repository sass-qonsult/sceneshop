# SceneShop local development
NODE_ENV=development
DEMO=1
DATA_BACKEND=file
PORT=3000

# Production baseline (v0.9 Data Plane target)
# NODE_ENV=production
# DEMO=0
# DATA_BACKEND=postgres
# DATABASE_URL=postgres://user:password@host:5432/sceneshop
# PUBLIC_URL=https://sceneshop.example
# SESSION_SECRET=replace-with-at-least-32-random-characters
# TRUST_PROXY=1

# Realtime authority (v0.9 alpha.7+)
# REDIS_URL=redis://localhost:6379
# SESSION_BACKEND=redis

# Release/live validation (use dedicated test/dev services, never production data)
# LIVE_DATABASE_URL=postgres://user:password@host:5432/sceneshop_dev
# LIVE_REDIS_URL=redis://localhost:6379

# v0.17 Scale & Reliability — transactional outbox worker
# Run separately from the web process: npm run worker:outbox
# OUTBOX_WEBHOOK_URL=https://events.internal.example/sceneshop
# OUTBOX_WEBHOOK_SECRET=replace-with-a-secret-managed-value
# OUTBOX_WORKER_ID=sceneshop-worker-01
# OUTBOX_BATCH_SIZE=20
# OUTBOX_LEASE_MS=30000
# OUTBOX_POLL_MS=1000
# OUTBOX_MAX_ATTEMPTS=8
# OUTBOX_BACKOFF_BASE_MS=1000
# OUTBOX_BACKOFF_MAX_MS=60000
# OUTBOX_WORKER_STALE_MS=120000
# OUTBOX_WEBHOOK_TIMEOUT_MS=10000

# v0.19 RC production contract
# CACHE_BACKEND=redis
# CACHE_PREFIX=sceneshop
# Optional outbox delivery requires both HTTPS endpoint and managed secret:
# OUTBOX_WEBHOOK_URL=https://events.internal.example/sceneshop
# OUTBOX_WEBHOOK_SECRET=managed-secret-at-least-24-characters
# RC schema compatibility uses a dedicated test database and creates/drops an isolated schema:
# RC_DATABASE_URL=postgresql://user:password@host:5432/sceneshop_rc_validation
